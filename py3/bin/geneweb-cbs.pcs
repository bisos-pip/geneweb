#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.geneweb/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
geneweb-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- GeneWeb's gwd as geneweb.here
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: genewebCbs-sbom.pcs, which runs geneweb-sbom.pcs (account, the GeneWeb zip, config, the
demo base) and genewebUsage-sbom.pcs (the GEDCOM tools); the geneweb unit; and geneweb-assemble.cs
(geneweb.here dns + nginx vhost).
cba_seed takes one sbom, hence genewebCbs-sbom.pcs rather than both names here.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom="genewebCbs-sbom.pcs",
    assemble="geneweb-assemble.cs",
    materialize=None,
)

sysdUnitsListGeneweb = [
    cba_sysd_seed.sysdUnit("geneweb", "geneweb-sysd.pcs"),
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListGeneweb,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
